  },
  "dependencies": {
    "@mota/contracts": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.7",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
