    {
      "id": "claim_8a6308b515e74a6bb65de2d082ea0e3c",
      "statement": "The API boot sequence is strictly ordered in main.ts: loadEnv (env validation), createDatabase, migrateDatabase (from MIGRATIONS_PATH, default /app/drizzle), then AppModule.register with production knobs (warmTransitCatalogs true, 10,000 bus / 100 subway catalog minimums), then app.listen. Migrations therefore run at every boot before the listener exists, so an unreachable database or failing migration is a boot failure rather than a half-serving API.",
      "evidence": [
        {
          "resource": "repo://apps/api/src/config/env.ts#L22-L23",
          "version": "repo-lines-v1:sha256:2f3495c12b3352b97e864fe6d1aff93360c0a14ca7d062afe4c7c0a01d20aa08:"
        },
