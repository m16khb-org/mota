  "claims": [
    {
      "id": "claim_fdabc76365584fa8ad34d9aa2c415eb7",
      "statement": "Mota is a pnpm workspace managed by Turborepo with exactly four workspaces: apps/web (@mota/web, React 19 + Vite PWA with Leaflet map and anonymous localStorage storage), apps/api (@mota/api, NestJS 11 on Fastify with /api/* controllers, Seoul upstream adapters, Supabase PKCE login, and JWKS verification), packages/contracts (@mota/contracts, the only code both apps share — Zod schemas), and packages/db (@mota/db, Drizzle ORM with the PostgreSQL schema, migrations, and user_settings repository).",
      "evidence": [
        {
          "resource": "repo://AGENTS.md#L11-L16",
          "version": "repo-lines-v1:sha256:990476bc1d99d9bbbcb45f3065cbc9ac0346de066ca166eb5ca83c9f18066f3b:"
