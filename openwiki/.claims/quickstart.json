    {
      "id": "claim_249871a5b8634513a6638b00705a277b",
      "statement": "Everything the API reads from the environment is validated by a single Zod schema in apps/api/src/config/env.ts at boot. Two resolution rules matter: DATABASE_URL wins over the DATABASE_* parts (which are otherwise assembled into a postgres:// URL with encodeURIComponent applied to user, password, and database name), and boot fails with `DATABASE_URL or DATABASE_PASSWORD is required.` when neither is present. SUPABASE_URL and SUPABASE_ANON_KEY are required with no default.",
      "evidence": [
        {
          "resource": "repo://apps/api/src/config/env.ts#L50-L62",
          "version": "repo-lines-v1:sha256:0d193a04eeccdb59061dfadd5a2b9fae26223566181af13b0e6907b42ddda6cc:"
        },
        {
