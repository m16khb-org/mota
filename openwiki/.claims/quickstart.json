    {
      "id": "claim_9433cf59a0c541a282913112150c19d3",
      "statement": "No repository code or script loads a dotenv file — loadEnv() reads process.env directly (defaulting its source to process.env), packages/db/src/migrate.ts and drizzle.config.ts read process.env.DATABASE_URL, and the API tests read process.env.DATABASE_URL — so environment values must be exported into the shell rather than assumed to be picked up from .env. The drizzle-kit CLI is the partial exception: it bundles dotenv and auto-loads a .env from its own working directory (packages/db/), which plain tsx-based db:migrate does not.",
      "evidence": [
        {
          "resource": "repo://apps/api/src/config/env.ts#L47-L50",
          "version": "repo-lines-v1:sha256:24d7c8fc336a3ef380ad8e158bd33126a036b6ca2744ba93716eaf1cab466710:"
