    {
      "id": "claim_3c258d66f3cf4f13ad915c7434e845bf",
      "statement": "The authorize URL is constructed by OAuthController.startLogin with provider=google, prompt=select_account (so Google always shows its account chooser), redirect_to set to ${PUBLIC_URL}/api/auth/callback with the random state appended as a query parameter, code_challenge from the S256 PKCE derivation, and code_challenge_method=S256; the route returns it as a 302 redirect rather than fetching it.",
      "evidence": [
