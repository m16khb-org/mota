    {
      "id": "claim_4595d17a63a34c138612d3d8e546c829",
      "statement": "If an access token obtained seconds earlier from a successful refresh grant fails local verification, verifySupabaseSession throws SupabaseUnavailableError (surfacing as 503) rather than returning null, on the grounds that a just-minted token should verify and its failure signals infrastructure or key-set trouble.",
      "evidence": [
