    {
      "id": "claim_8323c38ddc1f45bc91f1c05a135733ea",
      "statement": "verifySupabaseSession checks the access cookie locally first and returns its user on success; only when that is absent or invalid does it fall back to the refresh cookie, POSTing the refresh_token grant server-side, relaying the rotated cookies back to the caller through the onSetCookie callback, and verifying the fresh access token locally before returning its user.",
      "evidence": [
        {
          "resource": "repo://apps/api/src/auth/session.ts#L31-L76",
          "version": "repo-lines-v1:sha256:a468472511d983049356aa3f11e1c6e62322b0fbe9772649eec647de630a4c7f:"
        }
