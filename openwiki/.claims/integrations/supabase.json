    {
      "id": "claim_40af30ae55ae44a78fdeda1a80442410",
      "statement": "The OAuth callback origin is derived from PUBLIC_URL, so the redirect_to target must be allow-listed in the Supabase project's URL configuration; deploying under a new origin without updating the Supabase allow-list breaks login at the provider step rather than inside mota's code.",
      "evidence": [
        {
