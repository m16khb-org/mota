  "claims": [
    {
      "id": "claim_6af3c65358bc43c0b59dac5e542a6f66",
      "statement": "Mota's Supabase Auth integration touches exactly four endpoints and nothing more: GET /auth/v1/authorize (built as a browser redirect by OAuthController, never fetched server-side), POST /auth/v1/token?grant_type=pkce and POST /auth/v1/token?grant_type=refresh_token (SupabaseAuthClient.requestSession), POST /auth/v1/signout (SupabaseAuthClient.revokeSession), and GET /auth/v1/.well-known/jwks.json fetched by jose's remote resolver inside verifyAccessToken.",
      "evidence": [
        {
          "resource": "repo://apps/api/src/auth/oauth.controller.ts#L76-L84",
          "version": "repo-lines-v1:sha256:18645ceddffaa41ad5a5e7e086e8fa45a7926d92349569eae8d3bc30b7772bfc:"
        },
        {
