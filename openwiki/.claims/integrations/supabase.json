    },
    {
      "id": "claim_0affdd85e8984ae89463e1d63cef61fd",
      "statement": "SUPABASE_URL (must be a valid URL) and SUPABASE_ANON_KEY (non-empty) are required by the Zod env schema, so startup fails before anything binds when they are absent; PUBLIC_URL defaults to http://localhost:5173, and loadEnv strips trailing slashes from both supabaseUrl and publicUrl so the issuer and redirect_to callback are canonical regardless of how the variables are written.",
