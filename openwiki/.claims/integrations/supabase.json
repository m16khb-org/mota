        }
      ]
    },
    {
      "id": "claim_bfe01abccbf54b9a959bbba860906c7d",
      "statement": "All three SupabaseAuthClient HTTP calls send the anon key as the apikey header; only signout additionally sends the access token as an Authorization Bearer header and the refresh token in the JSON body. Each call passes signal: AbortSignal.timeout(10_000) and there is no retry, backoff, or circuit breaker — a hung upstream surfaces as a fetch rejection that becomes SupabaseUnavailableError.",
      "evidence": [
        {
          "resource": "repo://apps/api/src/auth/supabaseClient.ts#L60-L116",
          "version": "repo-lines-v1:sha256:c6df838cd25590333f49fdc06848f7aadd0473c4378cb19dd25f2767f860aff7:"
        }
      ]
    },
    {
      "id": "claim_aaab6232c38d4304a43e3f40a65ae8ae",
      "statement": "verifyAccessToken enforces, via jose's jwtVerify plus a Zod claims schema: algorithm ES256 only, issuer exactly `${supabaseUrl}/auth/v1`, audience 'authenticated', a 5-second clock tolerance, and a role claim that must be the literal 'authenticated'; sub is required (min length 1) and email is optional but must be a valid email. It returns AuthUser ({ sub, email? }) or null, never exposing other Supabase claims to callers.",
      "evidence": [
        {
          "resource": "repo://apps/api/src/auth/supabaseJwt.ts#L36-L63",
          "version": "repo-lines-v1:sha256:307f473aa903fac56b329b6022a9cffc5eb3b0585506c18e5427b8559092ad16:"
        },
        {
