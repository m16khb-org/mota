          "version": "repo-lines-v1:sha256:69b19aeeff030750c5bb152af803c087875fb53d18d31c1803ab383e76633f75:"
        }
      ]
    },
    {
      "id": "claim_66fec2a2c8a04d458ae5261a25cf9cb6",
      "statement": "The two error classes map to distinct HTTP outcomes: SupabaseAuthError is a definitive rejection that yields a null user (anonymous 200 { authenticated: false } on /api/auth/session, 401 AUTH_REQUIRED on /api/settings, or 401 AUTH_CALLBACK_INVALID on the OAuth callback after clearing flow cookies), while SupabaseUnavailableError always becomes 503 AUTH_UPSTREAM_UNAVAILABLE with the Korean message 로그인 상태를 확인하지 못했습니다.",
      "evidence": [
        {
          "resource": "repo://apps/api/src/auth/auth.controller.ts#L24-L45",
          "version": "repo-lines-v1:sha256:90bc9a2ab11da4f2ad4c7d5adedf0f62b5741efec7f27b8876e53ff0d7d813f6:"
