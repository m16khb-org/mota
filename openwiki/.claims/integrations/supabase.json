    },
    {
      "id": "claim_4891b30a3a944c26ade207ac7a6e5f01",
      "statement": "PUBLIC_URL is the security switch for cookie naming: secureCookies(publicUrl) returns true only for https: origins, selecting the __Host- prefix for all five auth cookie names, while plain-HTTP local development uses unprefixed names. Both variants are host-only, HttpOnly, SameSite=Lax, Path=/, and never carry a Domain attribute — which is why mota exchanges the one-time login code for its own cookies instead of forwarding auth-gateway cookies.",
      "evidence": [
        {
          "resource": "repo://apps/api/src/auth/sessionCookies.ts#L124-L131",
          "version": "repo-lines-v1:sha256:2e68c58cd8631c4c1c0542cf13519cc06b5f839cea384824ed97ba502af7637f:"
