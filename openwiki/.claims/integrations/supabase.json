    {
      "id": "claim_3fc8e553c90b492b9a67bdfcfa30bf98",
      "statement": "Every token response is validated by a strict Zod session schema requiring non-empty access_token and refresh_token, a positive integer expires_in, and a non-empty token_type; a non-OK HTTP status or a body that fails this schema raises SupabaseAuthError, meaning the four fields are the only session data that crosses the integration boundary.",
      "evidence": [
        {
          "resource": "repo://apps/api/src/auth/supabaseClient.ts#L108-L116",
          "version": "repo-lines-v1:sha256:69a3195ec50fa4bc9a03c66853e1035a95d9439ca3a2899d5e39dedda6435076:"
        },
        {
