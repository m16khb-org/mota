        },
        {
          "resource": "repo://apps/web/src/components/MapCanvas.tsx#L452-L456",
          "version": "repo-lines-v1:sha256:b6ccdc10fcb89456171866928b93d5628015b86ef16763c99f25fd25cc14e953:"
        }
