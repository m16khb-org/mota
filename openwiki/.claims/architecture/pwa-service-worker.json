    {
      "id": "claim_ca95caa642984319a99d30b46aca7008",
      "statement": "pwa.test.ts enforces that the shell version number matches across four markers — the register-sw.js?v=N src in index.html, the sw.js?v=N registration URL in register-sw.js, the cache name mota-shell-vN in sw.js, and the precached /register-sw.js?v=N in sw.js (regex tolerating the legacy commute-bus prefix) — so releasing a new shell requires a coordinated bump in all four places.",
      "evidence": [
