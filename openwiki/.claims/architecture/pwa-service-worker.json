    {
      "id": "claim_4e317a0f3b5046d6a2067d9a449257a7",
      "statement": "In production the worker, registration script, manifest, and icons are static files from the Vite build served by the NestJS Fastify app: main.ts mounts useStaticAssets with root env.webDistPath (default /app/web, set to the copied apps/web/dist in the Dockerfile) at prefix \"/\" with wildcard false, and WebController's @Get(\"*\") returns index.html only for text/html requests not under /api/, otherwise 404 — so /api/* can never fall through to the shell.",
      "evidence": [
        {
          "resource": "repo://Dockerfile#L33-L33",
          "version": "repo-lines-v1:sha256:d4b9a7128e13a3f5654ec2dd6d5f0d6e50d5985e174a1f0ec49120d829dcfdf7:"
        },
