          "version": "repo-lines-v1:sha256:a767566bb0f7a96b84196765e55ef61bb98f28fcc556cdc90528ab1d7d2c4980:"
        }
      ]
    },
    {
      "id": "claim_dcf7cbb8aaf54dd09a21acae89a28156",
      "statement": "The degraded path is bus-only: nearbyStops catches UpstreamError from bus.read() and falls back to fetchLiveNearbyStops (the same selectNearStops.do endpoint scoped to the user's location, kiloMeter = radius/1000, 8 s timeout) while rethrowing non-UpstreamError failures; nearbySubway has no fallback and its errors propagate to the controller's 502 UPSTREAM_UNAVAILABLE — pinned by transit-catalog-fallback.e2e.test.ts, which shows a count-gate rejection (kiloMeter=45) answered by a live lookup (kiloMeter=0.8).",
      "evidence": [
        {
          "resource": "repo://apps/api/src/transit/transit.controller.ts#L53-L72",
          "version": "repo-lines-v1:sha256:111da34800649548ea308cc76968dbb946bf512e2847854f7d7d8d0e9753a27a:"
        },
