    {
      "id": "claim_a8c7891edcfe45d8877bfe91d5a32aff",
      "statement": "Refresh scheduling is jittered on success but not on retry: a success schedules the next refresh at refreshMs * (1 + random() * 0.1) using the injectable options.random (default Math.random, so the 24 h default lands uniformly in [24 h, 26.4 h]), while a failure sets retryAfter = now + retryMs and schedules a plain retryMs timer that fires exactly as the backoff window expires; timers are unref()ed, replaced on each schedule, and cleared by stop().",
      "evidence": [
        {
          "resource": "repo://apps/api/src/app.module.ts#L79-L87",
          "version": "repo-lines-v1:sha256:ac1886bc27f4eaef5f374049275f39e4d060dab1e26890e62198cd1d3572979f:"
        },
        {
          "resource": "repo://apps/api/src/transit/managedCatalog.ts#L129-L180",
          "version": "repo-lines-v1:sha256:301dd6940ce134243c8169db42f5bf4325e76b9885ae489feefd0e67da25a223:"
        }
      ]
