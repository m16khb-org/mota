    {
      "id": "claim_8017373400d54343b76fc363a05db20a",
      "statement": "refreshIfDue() is the gate every scheduled timer routes through: it returns false without loading when the snapshot is still fresh or now() is before retryAfter, so a timer firing mid-backoff does nothing rather than hammering a dead upstream; refreshNow() bypasses the gates, and TransitCatalogService.refreshDueCatalogs() runs both catalogs' refreshIfDue under Promise.allSettled — neither refreshNow nor refreshDueCatalogs currently has a caller in the repository.",
      "evidence": [
        {
          "resource": "repo://apps/api/src/transit/managedCatalog.ts#L84-L100",
          "version": "repo-lines-v1:sha256:6f0fd8184117034cad0b003f033e6f32666b8f084fc8662bebe900f7d665c2d9:"
