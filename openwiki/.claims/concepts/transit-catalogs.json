        }
      ]
    },
    {
      "id": "claim_9af70af5228a4400afb136aa5b6f3279",
      "statement": "The catalog adapters enforce a byte cap before parsing — fetchStopCatalog rejects responses over 10 MiB (30 s abort timeout) and fetchSubwayStationCatalog rejects responses over 1 MiB (15 s abort timeout) — and non-2xx statuses also raise UpstreamError, bounding memory and rejecting misrouted or HTML error payloads posing as catalogs.",
      "evidence": [
        {
          "resource": "repo://apps/api/src/upstream/officialSubwayStations.ts#L8-L41",
          "version": "repo-lines-v1:sha256:a5737817941b40d9ef7a46a450f585f480ea0dc57f46912b90d4e6c8c6585d2b:"
