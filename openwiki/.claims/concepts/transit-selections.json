    {
      "id": "claim_d6c67409985b43ea9188f38788331d35",
      "statement": "`addBusStopsToCommute` is a no-op on an empty batch; otherwise saved stops are deduped through a `Map` keyed by id so re-adding an already-saved stop updates its record in place without reordering, and the selection ids are unioned (existing ids first, new ids appended) then sliced to 4. The consequence is that when the context already has 4 watched stops, a newly saved stop is silently dropped from the selection while still being saved in `busStops` — the slice is the real guard on this batch-add path, because `App`'s cap announcement only guards the list-row toggle.",
      "evidence": [
        {
          "resource": "repo://apps/web/src/App.tsx#L112-L126",
          "version": "repo-lines-v1:sha256:affee4e1cbb6c16302129fb004ae8c3c59bcedea7c2e57bd6c93d4f142d035c0:"
