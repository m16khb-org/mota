{
  "schema_version": 1,
  "max_root_lines": 250,
  "max_module_lines": 250,
  "families": [
    {
      "root": ".agent-harness/ADR.md",
      "module_dir": ".agent-harness/adr",
      "responsibility": "accepted architecture decisions and roadmap"
    },
    {
      "root": ".agent-harness/ARCHITECTURE.md",
      "module_dir": ".agent-harness/architecture",
      "responsibility": "dependency direction and runtime topology",
      "modules": [
        {
          "path": ".agent-harness/architecture/overview.md",
          "responsibility": "architecture style, dependency graph, and change placement"
        },
        {
          "path": ".agent-harness/architecture/product-and-workspaces.md",
          "responsibility": "product boundary, workspace ownership, and browser composition"
        },
        {
          "path": ".agent-harness/architecture/api-and-transit.md",
          "responsibility": "Nest HTTP surface and Seoul transit adapter flow"
        },
        {
          "path": ".agent-harness/architecture/identity-and-settings.md",
          "responsibility": "Supabase PKCE identity and versioned settings persistence"
        },
        {
          "path": ".agent-harness/architecture/deployment.md",
          "responsibility": "production image, static serving, networks, and persistence"
        }
      ]
    },
    {
      "root": ".agent-harness/CAUTIONS.md",
      "module_dir": ".agent-harness/cautions",
      "responsibility": "known risks and incident lessons"
    },
    {
      "root": ".agent-harness/CONVENTIONS.md",
      "module_dir": ".agent-harness/conventions",
      "responsibility": "implementation and interface conventions"
    },
    {
      "root": ".agent-harness/OPERATIONS.md",
      "module_dir": ".agent-harness/operations/guides",
      "responsibility": "installation and runtime operation"
    },
    {
      "root": ".agent-harness/TESTING.md",
      "module_dir": ".agent-harness/testing",
      "responsibility": "test strategy and verification gates"
    }
  ],
  "single_owner_topics": {
    "OpenAPI requirements": ".agent-harness/OPEN_API_SPEC.md",
    "agent execution sequence": ".agent-harness/AGENT_WORKFLOW.md",
    "commit formatting": ".agent-harness/COMMIT_POLICY.md",
    "constitutional priority and safety": ".agent-harness/CONSTITUTION.md",
    "technology selection": ".agent-harness/TECH_STACK.md"
  }
}
