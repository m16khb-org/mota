# Supabase Auth (same project as auth-gateway)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxx

# Public origin of this service; https:// selects __Host- cookie prefixes.
PUBLIC_URL=http://localhost:5173

# Seoul subway arrivals proxy (k-skill). Defaults to the shared proxy origin;
# override only the origin — the adapter appends /v1/seoul-subway/arrival.
# SUBWAY_ARRIVAL_UPSTREAM=https://k-skill-proxy.nomadamas.org

# Mota uses the dedicated `mota` role/database in home-server-infra.
# Production Compose loads POSTGRES_PASSWORD from ../home-server-infra/.env.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=15432
DATABASE_NAME=mota
DATABASE_USER=mota
DATABASE_PASSWORD=change-me
