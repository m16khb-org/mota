# Public Google login gateway used by the React build.
VITE_AUTH_GATEWAY_URL=https://auth.m16khb.xyz

# Internal auth-gateway service used by the Nest API for /me verification.
AUTH_GATEWAY_URL=http://auth-gateway:3000

# Mota uses the dedicated `mota` role/database in home-server-infra.
# Production Compose loads POSTGRES_PASSWORD from ../home-server-infra/.env.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=15432
DATABASE_NAME=mota
DATABASE_USER=mota
DATABASE_PASSWORD=change-me
