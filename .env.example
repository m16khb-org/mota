# Central auth-gateway SSO (Google OAuth via Supabase).
# Mota proxies /api/auth/google and /auth/callback to the gateway and relays
# every Set-Cookie, so it holds no Supabase key of its own. SUPABASE_URL is
# only the JWKS issuer the session token is verified against.
SUPABASE_URL=https://<project-ref>.supabase.co
AUTH_GATEWAY_URL=https://auth.m16khb.xyz

# Public origin of this service; https:// selects __Host- cookie prefixes.
PUBLIC_URL=http://localhost:5173

# The bus-stop catalog refreshes in memory every 24 hours.
# TRANSIT_CATALOG_REFRESH_MS=86400000

# Mota uses the dedicated `mota` role/database in home-server-infra.
# Production Compose loads POSTGRES_PASSWORD from ../home-server-infra/.env.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=15432
DATABASE_NAME=mota
DATABASE_USER=mota
DATABASE_PASSWORD=change-me
