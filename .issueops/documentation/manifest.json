{
  "schema_version": 1,
  "max_root_lines": 250,
  "max_module_lines": 250,
  "families": [
    {
      "root": ".issueops/ADR.md",
      "module_dir": ".issueops/adr",
      "responsibility": "accepted architecture decisions and roadmap"
    },
    {
      "root": ".issueops/ARCHITECTURE.md",
      "module_dir": ".issueops/architecture",
      "responsibility": "dependency direction and runtime topology",
      "modules": [
        {
          "path": ".issueops/architecture/overview.md",
          "responsibility": "architecture style, dependency graph, and change placement"
        },
        {
          "path": ".issueops/architecture/product-and-workspaces.md",
          "responsibility": "product boundary, workspace ownership, and browser composition"
        },
        {
          "path": ".issueops/architecture/api-and-transit.md",
          "responsibility": "Nest HTTP surface and Seoul transit adapter flow"
        },
        {
          "path": ".issueops/architecture/identity-and-settings.md",
          "responsibility": "Auth-gateway login proxy identity and versioned settings persistence"
        },
        {
          "path": ".issueops/architecture/deployment.md",
          "responsibility": "production image, static serving, networks, and persistence"
        }
      ]
    },
    {
      "root": ".issueops/CAUTIONS.md",
      "module_dir": ".issueops/cautions",
      "responsibility": "known risks and incident lessons"
    },
    {
      "root": ".issueops/CONVENTIONS.md",
      "module_dir": ".issueops/conventions",
      "responsibility": "implementation and interface conventions"
    },
    {
      "root": ".issueops/OPERATIONS.md",
      "module_dir": ".issueops/operations/guides",
      "responsibility": "installation and runtime operation"
    },
    {
      "root": ".issueops/TESTING.md",
      "module_dir": ".issueops/testing",
      "responsibility": "test strategy and verification gates"
    }
  ],
  "single_owner_topics": {
    "OpenAPI requirements": ".issueops/OPEN_API_SPEC.md",
    "agent execution sequence": ".issueops/AGENT_WORKFLOW.md",
    "commit formatting": ".issueops/COMMIT_POLICY.md",
    "constitutional priority and safety": ".issueops/CONSTITUTION.md",
    "technology selection": ".issueops/TECH_STACK.md"
  }
}
